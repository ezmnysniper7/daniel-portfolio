# Resend API Key - Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Configuration
# The email address where contact form submissions will be sent
CONTACT_EMAIL=chendaniel150701@gmail.com

# Upstash Redis visitor counter
# Create a free Redis database at https://upstash.com and copy the REST URL/token
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# Analytics. On automatically for the Vercel production build (see next.config.js); Web Analytics must be enabled
# for the project in the Vercel dashboard. Set to "off" to stop it, or "vercel" to force it on elsewhere.
# Cookieless page views; the custom events (enquiry_submitted, cta clicks) need a Vercel plan that includes them.
NEXT_PUBLIC_ANALYTICS=
